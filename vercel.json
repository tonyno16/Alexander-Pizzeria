      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://www.instagram.com https://cdn.iubenda.com https://cs.iubenda.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://static.cdninstagram.com https://cdn.iubenda.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; frame-src https://app.lasagna.marketing https://www.instagram.com https://www.facebook.com https://pnssm.pro https://*.pnssm.pro https://*.forms.pienissimo.pro https://*.menu.pienissimo.pro https://*.delivery.pienissimo.pro https://www.google.com https://vercel.live; connect-src 'self' https://www.facebook.com https://www.google-analytics.com https://www.googletagmanager.com https://*.analytics.google.com https://connect.facebook.net https://cs.iubenda.com https://cdn.iubenda.com https://idb.iubenda.com https://pnssm.pro; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
